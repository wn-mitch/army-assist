{
    "name": "army-assist",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite --host",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "build_preview": "tsc -b && vite build && vite preview",
        "cy:open": "cypress open",
        "cy:run_all": "rm -f results.txt && cypress run >> results.txt",
        "cy:run_fast": "rm -f results.txt && cypress run --spec 'cypress/e2e/*.cy.ts' >> results.txt",
        "deploy:wrangler": "wrangler pages deploy dist",
        "convert:phases": "source venv/bin/activate && python3 src/assets/convert.py && python3 src/assets/phases.py",
        "build:deploy:wrangler": "tsc -b && vite build && wrangler pages deploy dist"
    },
    "dependencies": {
        "@alpaca-software/40kdc-data": "^0.5.1",
        "@headlessui/react": "^2.2.0",
        "@heroicons/react": "^2.2.0",
        "@types/pako": "^2.0.3",
        "clsx": "^2.1.1",
        "cypress-real-events": "^1.14.0",
        "flowbite": "^3.0.0",
        "lz-string": "^1.5.0",
        "node-gzip": "^1.1.2",
        "pako": "^2.1.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-icons": "^5.4.0",
        "react-qr-code": "^2.0.15",
        "react-svg-to-image": "^3.0.0",
        "react-to-print": "^3.0.5",
        "uuid": "^11.1.0",
        "yarn": "^1.22.22",
        "zustand": "^5.0.2"
    },
    "devDependencies": {
        "@cypress/code-coverage": "^3.13.11",
        "@eslint/js": "^9.17.0",
        "@types/jest": "^29.5.14",
        "@types/mocha": "^10.0.10",
        "@types/node-gzip": "^1.1.3",
        "@types/react": "^18.3.18",
        "@types/react-dom": "^18.3.5",
        "@vitejs/plugin-react": "^4.3.4",
        "autoprefixer": "^10.4.20",
        "cypress": "^14.2.0",
        "eslint": "^9.17.0",
        "eslint-plugin-react-hooks": "^5.0.0",
        "eslint-plugin-react-refresh": "^0.4.16",
        "globals": "^15.14.0",
        "nyc": "^17.1.0",
        "postcss": "^8.4.49",
        "tailwindcss": "^3.4.17",
        "typescript": "~5.6.2",
        "typescript-eslint": "^8.18.2",
        "vite": "^6.0.7",
        "vite-plugin-istanbul": "^7.0.0",
        "wrangler": "^3.102.0"
    }
}
